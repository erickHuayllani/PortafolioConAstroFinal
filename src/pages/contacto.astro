---
import "../styles/contacto.css";
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <main class="contacto-container">

    <!-- Fondo animado -->
    <div class="stars"></div>
    <div class="aurora"></div>

    <section class="contact-header">
      <h1 class="contact-title">📬 ¡Hablemos!</h1>
      <p class="contact-subtitle">
        ¿Tienes un proyecto, una idea o simplemente quieres conectar?
        Estoy aquí para escucharte y crecer contigo.
      </p>
      <p class="contact-motivation">
        Soy una persona con grandes ganas de superarme, aprender día a día
        y convertirme en un profesional que aporte al futuro de mi país.  
        Cada mensaje, cada colaboración y cada oportunidad me acerca un paso más  
        a construir ese futuro. ¡Hagamos algo increíble juntos! 🚀🇵🇪
      </p>
    </section>

    <form class="contact-form">
      <div class="form-group">
        <label for="name">Nombre</label>
        <input type="text" id="name" name="name" placeholder="Tu nombre..." required />
      </div>

      <div class="form-group">
        <label for="email">Correo</label>
        <input type="email" id="email" name="email" placeholder="tu@email.com" required />
      </div>

      <div class="form-group">
        <label for="message">Mensaje</label>
        <textarea id="message" name="message" rows="6" placeholder="Escríbeme tu mensaje..." required></textarea>
      </div>

      <button type="submit" class="submit-btn">Enviar mensaje 🚀</button>
    </form>

  </main>
</BaseLayout>
