---
import "../styles/contacto.css";
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <!-- Aquí va el contenido específico de la página -->
</BaseLayout>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Contacto</title>
  </head>
  <body>
    <main class="contacto-container">
      <section class="contact-header">
        <h1 class="contact-title">📬 ¡Hablemos!</h1>
        <p class="contact-subtitle">¿Tienes un proyecto en mente o simplemente quieres saludar? ¡Estoy aquí!</p>
      </section>

      <form class="contact-form">
        <div class="form-group">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" placeholder="Tu nombre..." required />
        </div>

        <div class="form-group">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>

        <div class="form-group">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="6" placeholder="Escríbeme tu mensaje..." required></textarea>
        </div>

        <button type="submit" class="submit-btn">Enviar mensaje</button>
      </form>
    </main>
  </body>
</html>
