---
import Navbar from '../components/Navbar.astro';
import "../styles/loader-matrix.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Portafolio</title>
  </head>
  <body>

    <!-- Loader Matrix Pastel -->
    <div id="loader" class="loader-screen">
      <canvas id="matrix"></canvas>

      <div class="loader-content">
        <h1 class="loader-title" data-text="INITIALIZING SYSTEM...">INITIALIZING SYSTEM...</h1>

        <div class="loader-bar">
          <div class="loader-progress"></div>
        </div>

        <p class="loader-sub">Loading Erick Huayllani Profile...</p>
      </div>
    </div>

    <!-- Navbar y contenido real, oculto inicialmente -->
    <Navbar />
    <main id="main-content" style="display:none;">
      <slot />
    </main>

    <!-- Script JS para la animación -->
    <script is:inline>
      // MATRIX PASTEL BACKGROUND
      const canvas = document.getElementById("matrix");
      const ctx = canvas.getContext("2d");

      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      const letters = "01あアカサタナハマヤラワABCDEFGHIJKLMNOPQRSTUVWXYZ";
      const columns = Math.floor(canvas.width / 20);
      const drops = Array(columns).fill(1);

      function drawMatrix() {
        ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = `hsl(${Math.random()*360}, 70%, 80%)`;
        ctx.font = "18px monospace";

        drops.forEach((y, i) => {
          const text = letters[Math.floor(Math.random() * letters.length)];
          ctx.fillText(text, i * 20, y * 20);

          if(y * 20 > canvas.height && Math.random() > 0.975){
            drops[i] = 0;
          }
          drops[i]++;
        });
      }

      const matrixInterval = setInterval(drawMatrix, 40);

      // CARGA DEL LOADER
      const progress = document.querySelector(".loader-progress");
      let width = 0;
      const progressInterval = setInterval(() => {
        if(width >= 100){
          clearInterval(progressInterval);
        } else {
          width += 1.2; // velocidad de carga
          progress.style.width = width + "%";
        }
      }, 30);

      // DESAPARECER EL LOADER DESPUÉS DE 3s Y MOSTRAR CONTENIDO
      window.addEventListener("load", () => {
        setTimeout(() => {
          const loader = document.getElementById("loader");
          const mainContent = document.getElementById("main-content");
          loader.style.opacity = "0";
          setTimeout(() => {
            loader.style.display = "none";
            mainContent.style.display = "block";
            clearInterval(matrixInterval);
          }, 1000);
        }, 3000);
      });
    </script>

  </body>
</html>
